{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "*.jpg", "use": "@vercel/static" },
    { "src": "*.png", "use": "@vercel/static" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "*.css", "use": "@vercel/static" },
    { "src": "*.js", "use": "@vercel/static" }
  ],
  "rewrites": [
    { "source": "/api/log", "destination": "https://telegrambot-nv24.onrender.com/api/log" }
  ],
  "routes": [
    { "src": "/start_image.jpg", "dest": "/start_image.jpg" },
    { "src": "/uid_image.jpg", "dest": "/uid_image.jpg" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
